# Copy this file to .env. Never commit .env or share the API key.
# JARVIS currently supports Gemini as its BYOK cloud brain.
JARVIS_BRAIN_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLED=false

# Optional cloud voice output. Only used when Fish Audio is selected in Settings.
# Never put this value in Flutter code or commit your .env file.
FISH_API_KEY=
# Optional authorized Fish Audio voice model ID. Leave blank for the provider default.
FISH_REFERENCE_ID=
